{
  "schemaVersion": 1,
  "id": "id-card-reader",
  "version": "0.1.0",
  "description": "身份证读卡器插件：模拟读取固定结构的居民身份证信息",
  "type": "javascript",
  "entry": "main.js",
  "platforms": ["any"],
  "permissions": [],
  "plugin": {
    "kind": "id-card-reader",
    "mode": "mock",
    "transport": "mock",
    "contract": "foundry.id-card.v1"
  },
  "capabilities": {
    "devices": {
      "description": "枚举当前插件提供的模拟设备",
      "export": "devices",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "pluginKind": {
            "const": "id-card-reader"
          },
          "mode": {
            "enum": ["mock", "adapter"]
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "transport": {
                  "enum": [
                    "mock",
                    "usb",
                    "serial",
                    "hid",
                    "network",
                    "system",
                    "sdk"
                  ]
                },
                "status": {
                  "enum": ["ready", "unavailable"]
                }
              },
              "required": ["id", "name", "transport", "status"]
            },
            "maxItems": 256
          }
        },
        "required": ["schemaVersion", "pluginKind", "mode", "devices"]
      }
    },
    "read-card": {
      "description": "身份证读卡器插件：模拟读取固定结构的居民身份证信息",
      "export": "readCard",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": []
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "foundry.id-card.v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "pluginKind": {
            "const": "id-card-reader"
          },
          "mode": {
            "enum": ["mock", "adapter"]
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "documentType": {
                "const": "cn-resident-id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "gender": {
                "enum": ["male", "female", "unknown"]
              },
              "ethnicity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "birthDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "idNumber": {
                "type": "string",
                "pattern": "^[0-9]{17}[0-9X]$"
              },
              "issuingAuthority": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "validFrom": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "validTo": {
                "type": "string",
                "pattern": "^(\\d{4}-\\d{2}-\\d{2}|long-term)$"
              },
              "photo": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mimeType": {
                        "enum": ["image/png", "image/jpeg"]
                      },
                      "base64": {
                        "type": "string",
                        "minLength": 4,
                        "maxLength": 1048576,
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32768
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32768
                      }
                    },
                    "required": ["mimeType", "base64", "width", "height"]
                  }
                ]
              }
            },
            "required": [
              "documentType",
              "name",
              "gender",
              "ethnicity",
              "birthDate",
              "address",
              "idNumber",
              "issuingAuthority",
              "validFrom",
              "validTo",
              "photo"
            ]
          }
        },
        "required": ["schemaVersion", "pluginKind", "mode", "deviceId", "data"]
      }
    }
  }
}
