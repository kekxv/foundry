{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundry.camera.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginKind": {
      "const": "camera"
    },
    "mode": {
      "enum": ["mock", "adapter"]
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mimeType": {
              "enum": ["image/png", "image/jpeg"]
            },
            "base64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          },
          "required": ["mimeType", "base64", "width", "height"]
        }
      },
      "required": ["image"]
    }
  },
  "required": ["schemaVersion", "pluginKind", "mode", "deviceId", "data"]
}
