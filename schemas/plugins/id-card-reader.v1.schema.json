{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundry.id-card.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginKind": {
      "const": "id-card-reader"
    },
    "mode": {
      "enum": ["mock", "adapter"]
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": {
          "const": "cn-resident-id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "gender": {
          "enum": ["male", "female", "unknown"]
        },
        "ethnicity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "birthDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "idNumber": {
          "type": "string",
          "pattern": "^[0-9]{17}[0-9X]$"
        },
        "issuingAuthority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "validTo": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|long-term)$"
        },
        "photo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mimeType": {
                  "enum": ["image/png", "image/jpeg"]
                },
                "base64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 1048576,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                }
              },
              "required": ["mimeType", "base64", "width", "height"]
            }
          ]
        }
      },
      "required": [
        "documentType",
        "name",
        "gender",
        "ethnicity",
        "birthDate",
        "address",
        "idNumber",
        "issuingAuthority",
        "validFrom",
        "validTo",
        "photo"
      ]
    }
  },
  "required": ["schemaVersion", "pluginKind", "mode", "deviceId", "data"]
}
