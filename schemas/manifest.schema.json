{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "type",
    "entry",
    "platforms",
    "permissions",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "enum": ["javascript", "executable", "native-library"]
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "windows-x64",
          "macos-arm64",
          "linux-x64",
          "linux-arm64"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "process.spawn",
          "native.call",
          "filesystem.read",
          "filesystem.write"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "export", "input", "output"],
        "properties": {
          "description": {
            "type": "string"
          },
          "export": {
            "type": "string"
          },
          "input": {
            "type": ["object", "boolean"]
          },
          "output": {
            "type": ["object", "boolean"]
          }
        }
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "libraries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["abi", "paths", "symbols"],
        "properties": {
          "abi": {
            "const": "c"
          },
          "paths": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "symbols": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "parameters", "returns"],
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "enum": ["i32", "u32", "f64", "cstring", "buffer"]
                  }
                },
                "returns": {
                  "enum": ["void", "i32", "u32", "f64"]
                }
              }
            }
          }
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "transport", "contract"],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "mode": {
          "enum": ["mock", "adapter"]
        },
        "transport": {
          "enum": ["mock", "usb", "serial", "hid", "network", "system", "sdk"]
        },
        "contract": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "mock"
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "const": "mock"
              }
            }
          },
          "else": {
            "properties": {
              "transport": {
                "not": {
                  "const": "mock"
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["plugin"],
        "properties": {
          "plugin": {
            "properties": {
              "mode": {
                "const": "adapter"
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "type": {
                "const": "executable"
              },
              "permissions": {
                "contains": {
                  "const": "process.spawn"
                }
              }
            }
          },
          {
            "properties": {
              "type": {
                "const": "native-library"
              },
              "permissions": {
                "contains": {
                  "const": "native.call"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
