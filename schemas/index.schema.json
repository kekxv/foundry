{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry signed index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "expiresAt",
    "sourceCommit",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1
    },
    "sourceCommit": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "platform", "url", "size", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "withdrawnPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "platform", "url", "size", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "description": "Authenticated immutable history of withdrawn artifacts; never available for install/download."
    }
  }
}
