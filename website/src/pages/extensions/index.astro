---
import Base from '../../layouts/Base.astro';
import ExtensionCard from '../../components/ExtensionCard.astro';
import {extensions, hasRegistry} from '../../catalogue';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="扩展目录">
  <div class="page-title wrap">
    <div class="eyebrow">THE FOUNDRY REGISTRY</div>
    <h1>
      找到你的<span class="accent-word">下一项能力。</span>
    </h1>
    <p>
      纯 JavaScript、命令行或动态库，都是同样简单的接口。
      <br />
      查看能力、了解权限，再把它装进你的工具箱。
    </p>
  </div>
  <section class="catalogue wrap">
    <div class="catalogue-toolbar">
      <span>
        <b>{String(extensions.length).padStart(2, '0')}</b> 个正式扩展
      </span>
      <span>JAVASCRIPT / CLI / NATIVE</span>
    </div>
    <div class="cards">
      {extensions.map((extension, index) => (
        <ExtensionCard extension={extension} index={index} />
      ))}
    </div>
    <div class="registry-note">
      <span class="note-symbol" aria-hidden="true">
        i
      </span>
      <p>
        {hasRegistry
          ? '安装前请配置可信签名索引及公钥根。'
          : '首次签名发布准备中；当前可通过开发文档从本地构建体验。'}
      </p>
      <a href={`${base}/docs/`}>开始使用 ↗</a>
    </div>
    <div class="catalogue-contribute">
      <div class="eyebrow">ROOM FOR YOUR IDEAS.</div>
      <h2>工具箱里，还缺什么？</h2>
      <p>参考正式扩展，发布你自己的实现。</p>
      <a class="section-link" href={`${base}/docs/`}>
        扩展编写指南 ↗
      </a>
    </div>
  </section>
</Base>
