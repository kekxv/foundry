---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = '用 JavaScript 描述能力，以签名包分发。Foundry 连接 QuickJS、命令行与原生动态库。',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{title} — Foundry</title>
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      跳到正文
    </a>
    <header class="nav wrap">
      <a href={`${base}/`} class="brand" aria-label="Foundry 首页">
        <span class="brand-mark" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        foundry<span class="version">v0.1</span>
      </a>
      <nav aria-label="主导航">
        <a
          href={`${base}/extensions/`}
          aria-current={path.includes('/extensions/') ? 'page' : undefined}
        >
          扩展目录
        </a>
        <a
          href={`${base}/docs/`}
          aria-current={path.includes('/docs/') ? 'page' : undefined}
        >
          开发文档
        </a>
        <a class="nav-cta" href={`${base}/docs/#quick-start`}>
          开始构建 <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="wrap">
      <div>
        <a class="brand" href={`${base}/`}>
          foundry<span class="footer-dot" aria-hidden="true"></span>
        </a>
        <p>Small interface. Native possibilities.</p>
      </div>
      <div class="footer-links">
        <a href={`${base}/extensions/`}>探索扩展 ↗</a>
        <a href={`${base}/docs/`}>编写你的第一个扩展 ↗</a>
      </div>
      <span class="footer-meta">
        OPEN SOURCE, OPEN POSSIBILITIES.
        <br />
        Rust / QuickJS / libffi
      </span>
    </footer>
  </body>
</html>
