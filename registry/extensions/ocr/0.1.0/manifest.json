{
  "schemaVersion": 1,
  "id": "ocr",
  "version": "0.1.0",
  "description": "OCR 插件：固定结构的模拟文字识别结果",
  "type": "javascript",
  "entry": "main.js",
  "platforms": ["any"],
  "permissions": [],
  "plugin": {
    "kind": "ocr",
    "mode": "mock",
    "transport": "mock",
    "contract": "foundry.ocr.v1"
  },
  "capabilities": {
    "recognize": {
      "description": "OCR 插件：固定结构的模拟文字识别结果",
      "export": "recognize",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mimeType": {
                "enum": ["image/png", "image/jpeg"]
              },
              "base64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 1048576,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768
              }
            },
            "required": ["mimeType", "base64"]
          }
        },
        "required": ["image"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "foundry.ocr.v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "pluginKind": {
            "const": "ocr"
          },
          "mode": {
            "enum": ["mock", "adapter"]
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 1048576
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 65536
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "boundingBox": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["x", "y", "width", "height"]
                    }
                  },
                  "required": ["text", "confidence", "boundingBox"]
                },
                "maxItems": 256
              }
            },
            "required": ["text", "language", "blocks"]
          }
        },
        "required": ["schemaVersion", "pluginKind", "mode", "deviceId", "data"]
      }
    }
  }
}
